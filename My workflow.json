    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.text || '';\nconst cleaned = raw.replace(/```json|```/g, '').trim();\n\nlet data;\ntry {\n  data = JSON.parse(cleaned);\n} catch (e) {\n  return [{ json: { error: 'Could not parse AI output', raw } }];\n}\n\nconst rules = {\n  'CO-197': { category: 'Missing prior authorization', preventable: 'Yes', fix_tip: 'Get prior authorization before the service is performed.' },\n  'CO-16':  { category: 'Missing or incorrect information', preventable: 'Yes', fix_tip: 'Check all claim fields and attachments before submitting.' },\n  'CO-18':  { category: 'Duplicate claim', preventable: 'Yes', fix_tip: 'Check for an existing claim before resubmitting.' },\n  'CO-4':   { category: 'Coding mismatch', preventable: 'Yes', fix_tip: 'Verify the procedure code and modifier match.' },\n  'CO-29':  { category: 'Timely filing', preventable: 'Yes', fix_tip: 'Submit claims within the payer filing deadline.' },\n  'CO-242': { category: 'Out-of-network provider', preventable: 'No', fix_tip: 'Verify network status before the visit.' },\n  'CO-50':  { category: 'Not medically necessary', preventable: 'No', fix_tip: 'Appeal with supporting clinical documentation.' }\n};\n\nconst info = rules[data.denial_code] || {\n  category: 'Other',\n  preventable: 'Unknown',\n  fix_tip: 'Review the denial reason manually.'\n};\n\nreturn [{ json: { ...data, ...info } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
