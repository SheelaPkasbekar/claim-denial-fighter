    {
      "parameters": {
        "promptType": "define",
        "text": "=You are helping a patient or provider prepare an insurance appeal. Write a professional, polite appeal letter based only on the details below. Do not invent facts, and do not give medical or legal advice.\n\nDetails:\n- Payer: {{ $json.payer }}\n- Claim ID: {{ $json.claim_id }}\n- Member ID: {{ $json.member_id }}\n- Service date: {{ $json.service_date }}\n- Procedure: {{ $json.procedure }} (CPT {{ $json.cpt_code }})\n- Diagnosis: {{ $json.diagnosis }}\n- Billed amount: {{ $json.billed_amount }}\n- Denial code: {{ $json.denial_code }}\n- Denial reason: {{ $json.denial_reason }}\n- Denial category: {{ $json.category }}\n\nInstructions:\n1. Start with \"DRAFT - HUMAN REVIEW REQUIRED - SAMPLE DATA ONLY\".\n2. Address the letter to the payer's Appeals Department.\n3. Include the claim details, state that we are requesting reconsideration, and explain the request clearly based on the denial reason.\n4. List the supporting documents to attach (for example: medical records, provider letter, prior authorization proof if available).\n5. End with a polite closing and a placeholder for the sender's name and contact details.\n6. Keep it under 300 words.",
        "batching": {}
      },
